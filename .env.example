# Copy to .env.local for local development. Never commit real values.

# Minimum similarity (0-1) required to return a dataset answer. Higher = stricter, more fallbacks.
MATCH_CONFIDENCE_THRESHOLD=0.3

# Optional: use OpenAI for questions the dataset cannot answer.
# Keep the key server-side; never use a NEXT_PUBLIC_ prefix or commit the real key.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Optional: load a different dataset file (.json or .csv).
# DATASET_PATH=./data/medipot_healthcare_dataset_2000.csv

# Optional: Turso / libSQL. Leave unset to run entirely from the local dataset file.
# These are server-only variables (no NEXT_PUBLIC_ prefix) and are never sent to the browser.
# TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
# TURSO_AUTH_TOKEN=
